generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  nama      String
  email     String   @unique
  password  String
  roleId    String   @map("role_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role    Role     @relation(fields: [roleId], references: [id])
  events  Event[]  @relation("EventOwner")
  tickets Ticket[]

  @@index([roleId])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  nama        String  @map("nama_role")
  kode        String  @unique
  description String?

  users User[]

  @@map("roles")
}

model Event {
  id               String   @id @default(uuid()) @db.Uuid
  ownerId          String   @map("Owner_id") @db.Uuid
  judulEvent       String   @map("judul_event")
  deskripsi        String
  tanggalMulai     DateTime @map("tanggal_mulai")
  tanggalSelesai   DateTime @map("tanggal_selesai")
  lokasi           String 
  bannerUrl        String   @map("banner_url")
  statusVerifikasi Boolean  @map("status_verifikasi")
  createdAt        DateTime @default(now()) @map("created_at")

  owner       User         @relation("EventOwner", fields: [ownerId], references: [id])
  tickets     Ticket[]
  rabDetails  RABDetail[]
  committees  Committe[]

  @@index([ownerId])
  @@map("events")
}

model Ticket {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @map("event_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  kodeTiket       String   @map("kode_tiket")
  statusKehadiran Boolean  @map("status_kehadiran")
  waktuDaftar     DateTime @map("waktu_daftar")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@map("tickets")
}

model Committe {
  id            String @id @default(uuid()) @db.Uuid
  eventId       String @map("event_id") @db.Uuid
  namaPanitia   String @map("nama_panitia")
  posisiJabatan String @map("posisi_jabatan")
  kontak        String

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("committees")
}

model RABDetail {
  id            String  @id @default(uuid()) @db.Uuid
  eventId       String  @map("event_id") @db.Uuid
  namaItem      String  @map("nama_item")
  kategori      String
  jumlahUnit    Int     @map("jumlah_unit")
  estimasiBiaya Decimal @map("estimasi_biaya")

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("rab_details")
}