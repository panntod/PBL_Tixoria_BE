generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  nama           String
  email          String          @unique
  password       String
  noWhatsApp     String?         @map("no_whatsapp")
  institusi      String?         @map("institusi")
  roleId         String          @map("role_id") @db.Uuid
  isActive       Boolean         @default(true) @map("is_active")
  alasanSuspensi String?         @map("alasan_suspensi") @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  role           Role            @relation(fields: [roleId], references: [id])
  events         Event[]         @relation("EventOwner")
  tickets        Ticket[]
  committees     Committee[]
  moderationLogs ModerationLog[] @relation("AdminModerationLogs")

  @@index([roleId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  kode        String   @unique
  nama        String   @unique
  description String?

  users       User[]

  @@map("roles")
}

model Event {
  id               String               @id @default(uuid()) @db.Uuid
  ownerId          String               @map("owner_id") @db.Uuid
  judulEvent       String               @map("judul_event")
  deskripsi        String               @db.Text
  kategori         String               @default("Seminar") @map("kategori") // Seminar, Workshop, Konferensi, Kompetisi
  kuota            Int                  @default(100) @map("kuota")
  tanggalMulai     DateTime             @map("tanggal_mulai")
  tanggalSelesai   DateTime             @map("tanggal_selesai")
  namaTempat       String               @map("nama_tempat")
  kota             String               @map("kota")
  bannerUrl        String?              @map("banner_url")
  statusVerifikasi String               @default("DRAF") @map("status_verifikasi") // DRAF, MENUNGGU_TINJAUAN, DISETUJUI, TERBIT, DITOLAK, SELESAI, BATAL
  alasanPenolakan  String?              @map("alasan_penolakan") @db.Text
  alasanPembatalan String?              @map("alasan_pembatalan") @db.Text
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  owner            User                 @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ticketCategories TicketCategory[]
  tickets          Ticket[]
  rabDetails       RabDetail[]
  committees       Committee[]
  rundowns         Rundown[]
  submissionLogs   EventSubmissionLog[]
  moderationLogs   ModerationLog[]

  @@index([ownerId])
  @@map("events")
}

model TicketCategory {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  namaKategori String    @map("nama_kategori") // Umum, Mahasiswa, VIP
  harga        Decimal   @default(0) @map("harga")
  kuota        Int       @default(0) @map("kuota")
  mulaiJual    DateTime? @map("mulai_jual")
  berakhir     DateTime? @map("berakhir")
  wajibKTM     Boolean   @default(false) @map("wajib_ktm")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets      Ticket[]

  @@index([eventId])
  @@map("ticket_categories")
}

model Ticket {
  id               String          @id @default(uuid()) @db.Uuid
  eventId          String          @map("event_id") @db.Uuid
  ticketCategoryId String?         @map("ticket_category_id") @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  kodeTiket        String          @unique @map("kode_tiket")
  jenisTiket       String          @default("Umum") @map("jenis_tiket") // Umum, Mahasiswa, VIP
  statusTiket      String          @default("AKTIF") @map("status_tiket") // AKTIF / BATAL
  statusKehadiran  Boolean         @default(false) @map("status_kehadiran")
  waktuDaftar      DateTime        @default(now()) @map("waktu_daftar")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  event            Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketCategory   TicketCategory? @relation(fields: [ticketCategoryId], references: [id], onDelete: SetNull)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([ticketCategoryId])
  @@index([userId])
  @@map("tickets")
}

model Committee {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  namaPanitia   String    @map("nama_panitia")
  posisiJabatan String    @map("posisi_jabatan")
  divisi        String    @map("divisi") // Inti, Acara, Humas, Konsumsi, Perlengkapan, Dokumentasi
  kontak        String    @map("kontak") // No WhatsApp
  surel         String    @map("surel")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  rundowns      Rundown[]

  @@index([eventId])
  @@index([userId])
  @@map("committees")
}

model RabDetail {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  kategori  String   @map("kategori") // Konsumsi, Sewa tempat, Honor pembicara, Publikasi, dll.
  rencana   Decimal  @default(0) @map("rencana")
  realisasi Decimal  @default(0) @map("realisasi")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("rab_details")
}

model Rundown {
  id           String     @id @default(uuid()) @db.Uuid
  eventId      String     @map("event_id") @db.Uuid
  committeeId  String?    @map("committee_id") @db.Uuid // Sebagai PIC penanggung jawab sesi
  waktuMulai   String     @map("waktu_mulai") // Format jam (e.g. "07.30")
  waktuSelesai String     @map("waktu_selesai") // Format jam (e.g. "08.30")
  judulSesi    String     @map("judul_sesi")
  pembicara    String?    @map("pembicara")
  keterangan   String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pic          Committee? @relation(fields: [committeeId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([committeeId])
  @@map("rundowns")
}

model EventSubmissionLog {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  status    String   @map("status")
  catatan   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_submission_logs")
}

model ModerationLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  keputusan String   @map("keputusan") // 'DISETUJUI' atau 'DITOLAK'
  catatan   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  admin     User     @relation("AdminModerationLogs", fields: [adminId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([eventId])
  @@map("moderation_logs")
}